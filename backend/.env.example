# --- Emergent-compatible core ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=handoff
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=
# Public URL of the frontend (used for public listing links, QR capture links, Stripe redirects)
FRONTEND_URL=http://localhost:3000

# --- Behaviour ---
DEMO_MODE=true

# --- AI ---
# LLM_PROVIDER: anthropic | emergent | mock  (auto-picks anthropic if ANTHROPIC_API_KEY is set)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
EMERGENT_LLM_KEY=
# Voyage AI embeddings through MongoDB
MONGODB_AI_API_KEY=
MONGODB_AI_ENDPOINT=https://ai.mongodb.com/v1/embeddings
EMBEDDING_MODEL=voyage-4-lite

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Twilio (simulated if any missing) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Maps (public pk. token; falls back to OpenStreetMap) ---
MAPBOX_TOKEN=
